# Copy to .env (never commit .env). Load with: set -a; . ./.env; set +a
# Master password: V1RG0_MASTER_PW (zero) preferred; legacy V1RGO_MASTER_PW (letter O) also accepted.
V1RG0_MASTER_PW=change-me-to-a-long-random-string
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
# Disabled provider slots (enable in V1rG0_specific/v1rg0_providers.json first; model ids TO CONFIRM)
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# V1RG0_JUDGE_MODEL=deepseek_chat   # judge must be an enabled provider; no silent fallback
# Optional overrides
# V1RG0_DEFAULT_MODEL=deepseek_chat   # or kimi_k2_6
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_MODEL=kimi-k2.6
# KIMI_THINKING=disabled              # or enabled
V1RG0_MAX_TOKENS=4096
V1RG0_MAX_SAVED_CHARS=8000
# V1RG0_DATA_DIR=/workspace/V1rG0_data
# V1RG0_DLQ_MAX=500
# V1RG0_LOCK_STALE_SECONDS=600
# V1RG0_PROVIDERS_FILE=V1rG0_specific/v1rg0_providers.json   # enabled_providers defaults to ["deepseek"]
# V1RG0_HTTP_TIMEOUT=120
